osis_id, patient_id, diagnosis)\n        self.diagnoses.append(new_diagnosis)\n\n    def add_treatment(self, treatment_id, patient_id, treatment):\n        new_treatment = Treatment(treatment_id, patient_id, treatment)\n        self.treatments.append(new_treatment)\n\n    def get_patient_info(self, patient_id):\n        for patient in self.patients:\n            if patient.patient_id == patient_id:\n                return patient\n        return None\n\n    def get_diagnosis_info(self, diagnosis_id):\n        for diagnosis in self.diagnoses:\n            if diagnosis.diagnosis_id == diagnosis_id:\n                return diagnosis\n        return None\n\n    def get_treatment_info(self, treatment_id):\n        for treatment in self.treatments:\n            if treatment.treatment_id == treatment_id:\n                return treatment\n        return None\n\n    def save_to_file(self):\n        data = {\n            \"patients\": [],\n            \"diagnoses\": [],\n            \"treatments\": []\n        }\n        for patient in self.patients:\n            data[\"patients\"].append({\n                \"patient_id\": patient.patient_id,\n                \"name\": patient.name,\n                \"age\": patient.age,\n                \"medical_history\": patient.medical_history\n            })\n        for diagnosis in self.diagnoses:\n            data[\"diagnoses\"].append({\n                \"diagnosis_id\": diagnosis.diagnosis_id,\n                \"patient_id\": diagnosis.patient_id,\n                \"diagnosis\": diagnosis.diagnosis\n            })\n        for treatment in self.treatments:\n            data[\"treatments\"].append({\n                \"treatment_id\": treatment.treatment_id,\n                \"patient_id\": treatment.patient_id,\n                \"treatment\": treatment.treatment\n            })\n        with open(\"data/output/ai_healthcare_solution.json\", \"w\") as file:\n            json.dump(data, file, indent=4)\n\ndef main():\n    ai_healthcare_solution = AIHealthcareSolution()\n    ai_healthcare_solution.add_patient(\"P001\", \"John Doe\", 30, \"Hypertension\")\n    ai_healthcare_solution.add_diagnosis(\"D001\", \"P001\", \"Diabetes\")\n    ai_healthcare_solution.add_treatment(\"T001\", \"P001\", \"Insulin therapy\")\n    ai_healthcare_solution.save_to_file()\n    print(\"Data saved to data/output/ai_healthcare_solution.json\")\n\nif __name__ == \"__main__\":\n    main()\n```", "refusal": null, "role": "assistant", "annotations": null, "audio": null, "function_call": null, "tool_calls": null}}], "created": 1774320600, "model": "llama-3.3-70b-versatile", "object": "chat.completion", "service_tier": "on_demand", "system_fingerprint": "fp_68f543a7cc", "usage": {"completion_tokens": 736, "prompt_tokens": 131, "total_tokens": 867, "completion_tokens_details": null, "prompt_tokens_details": null, "queue_time": 0.048364355, "prompt_time": 0.007217444, "completion_time": 1.239870278, "total_time": 1.247087722}, "usage_breakdown": null, "x_groq": {"id": "req_01kmevzg4pftrvvzy6h588wa1a", "seed": 1895923452}}, "prompt_tokens": 131, "completion_tokens": 736, "agent_id": null}
